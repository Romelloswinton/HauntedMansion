</token><token name="BottomSurface">0</token><bool name="CastShadow">true</bool></Properties></Item><Item class="Part" referent="RBX234"><Properties><string name="Name">LobbyWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><Vector3 name="size"><X>60</X><Y>14</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>7</Y><Z>128</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4281348919</Color3uint8><token name="Material">512</token><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="CastShadow">true</bool></Properties></Item><Item class="Part" referent="RBX235"><Properties><string name="Name">LobbyWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><Vector3 name="size"><X>60</X><Y>14</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>7</Y><Z>172</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4281348919</Color3uint8><token name="Material">512</token><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="CastShadow">true</bool></Properties></Item><Item class="Part" referent="RBX238"><Properties><string name="Name">LobbyTitle</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><Vector3 name="size"><X>35</X><Y>4</Y><Z>0.3</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>10</Y><Z>128.7</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4279901212</Color3uint8><token name="Material">272</token><float name="T