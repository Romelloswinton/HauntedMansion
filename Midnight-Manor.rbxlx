SURVIVE FIVE MINUTES.
ONE SURVIVOR REMAINING = TEAM VICTORY.</string><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><float name="BackgroundTransparency">1</float><Color3 name="TextColor3"><R>0.8784313725490196</R><G>0.8274509803921568</G><B>0.6745098039215687</B></Color3><bool name="TextScaled">true</bool><bool name="TextWrapped">true</bool><token name="Font">19</token></Properties></Item></Item></Item></Item><Item class="SpawnLocation" referent="RBX243"><Properties><string name="Name">LobbySpawn</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><Vector3 name="size"><X>6</X><Y>0.4</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0.2</Y><Z>145</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283396715</Color3uint8><token name="Material">272</token><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="CastShadow">true</bool><bool name="Neutral">true</bool><int name="Duration">0</int><bool name="AllowTeamChangeOnTouch">false</bool></Properties></Item><Item class="Camera" referent="RBXCamera"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>98</X><Y>105</Y><Z>125</Z><R00>0.786973293702267</R00><R01>-0.3402415836868275</R01><R02>0.5146928207481478</R02><R10>0</R10><R11>0.8342035874475191</R11><R12>0.5514565936587298</R12><R20>-0.6169870622625773</R20><R21>-0.43398161184544326</R21><R22>0.6564959448318212</R22></CoordinateFrame><token name="CameraType">5</token></Properties></Item></Item><Item class="Lighting" referent="RBX248"><Properties><string name="Name">Lighting</string><float name="ClockTime">0.5</float><float name="Brightness">2</float><Color3 name="Ambient"><R>0.3058823529411765</R><G>0.3254901960784314</G><B>0.38823529411764707</B></Color3><Color3 name="OutdoorAmbient"><R>0.2</R><G>0.23921568627450981</G><B>0.3137254901960784</B></Color3><Color3 name="FogColor"><R>0.14901960784313725</R><G>0.1843137254901961</G><B>0.2235294117647059</B></Color3><float name="FogStart">60</float><float name="FogEnd">300</float><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX250"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX249"><Properties><string name="Name">MansionState</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX251"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX244"><Properties><string name="Name">RoundRules</string><ProtectedString name="Source">-- Pure game rules. No Roblox services: the same code runs in CLI tests and Studio.
local Rules = {}

function Rules.new(ids, killerId, now, duration, headStart)
    assert(#ids &gt;= 2 and #ids &lt;= 10, 'Rounds need 2 to 10 players')
    local members, alive = {}, {}
    for _, id in ipairs(ids) do
        assert(not members[id], 'Duplicate player')
        members[id] = true
        if id ~= killerId then alive[id] = true end
    end
    assert(members[killerId], 'Killer must be in the roster')
    assert(duration &gt; 0 and headStart &gt;= 0, 'Invalid round timing')
    return {
        members = members, alive = alive, killerId = killerId,
        chaseAt = now + headStart, endsAt = now + headStart + duration,
        result = nil,
    }
end

function Rules.count(state)
    local count = 0
    for _ in pairs(state.alive) do count += 1 end
    return count
end

function Rules.tick(state, now)
    if state.result then return state.result end
    -- The deadline wins ties. No late event can steal a survivor victory.
    if now &gt;= state.endsAt then
        state.result = 'Survivors'
    elseif Rules.count(state) == 0 then
        state.result = 'Killer'
    end
    return state.result
end

function Rules.capture(state, attackerId, victimId, now)
    if Rules.tick(state, now) or now &lt; state.chaseAt then return false end
    if attackerId ~= state.killerId or not state.alive[victimId] then return false end
    state.alive[victimId] = nil
    Rules.tick(state, now)
    return true
end

function Rules.remove(state, id, now)
    if Rules.tick(state, now) then return end
    if id == state.killerId then
        state.result = 'Cancelled'
    else
        state.alive[id] = nil
        Rules.tick(state, now)
    end
end

return Rules
</ProtectedString></Properties></Item><Item class="Script" referent="RBX245"><Properties><string name="Name">MansionServer</string><ProtectedString name="Source">local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local Rules = require(script.Parent:WaitForChild('RoundRules'))
local Config = { RoundSeconds = 300, HeadStart = 15, Intermission = 20, MaxPlayers = 10 }
local state = ReplicatedStorage:WaitForChild('MansionState')
local map = workspace:WaitForChild('Mansion')
local spawnFolder = workspace:WaitForChild('SurvivorSpawns')
local lobbySpawn = workspace:WaitForChild('LobbySpawn')
local killerSpawn = workspace:WaitForChild('KillerSpawn')
local entranceSpawn = workspace:WaitForChild('EntranceSpawn')
map:WaitForChild('Ceiling').Transparency = 0
local random = Random.new()
local round = nil
local touchConnections = {}
local loading = {}
local function now() return workspace:GetServerTimeNow() end
local function setRole(player, role) player:SetAttribute('MansionRole', role) end
local function setPhase(phase, endsAt, message)
    state:SetAttribute('Phase', phase)
    state:SetAttribute('EndsAt', endsAt or 0)
    state:SetAttribute('Message', message or '')
end
local function humanoid(player)
    return player.Character and player.Character:FindFirstChildOfClass('Humanoid')
end
local function root(player)
    return player.Character and player.Character:FindFirstChild('HumanoidRootPart')
end
local function teleport(player, destination)
    if player.Character and root(player) then
        root(player).AssemblyLinearVelocity = Vector3.zero
        root(player).AssemblyAngularVelocity = Vector3.zero
        player.Character:PivotTo(destination.CFrame + Vector3.new(0, 4, 0))
    end
end
local function updateAlive()
    state:SetAttribute('Alive', round and Rules.count(round) or 0)
end
local function retire(player)
    setRole(player, 'Spectator')
    teleport(player, lobbySpawn)
    local playerRoot = root(player)
    if playerRoot then playerRoot.Anchored = true end
    updateAlive()
end
local function safeReload(player)
    if loading[player] or player.Parent ~= Players then return end
    loading[player] = true
    task.spawn(function()
        local ok, err = pcall(function() player:LoadCharacterAsync() end)
        loading[player] = nil
        if not ok then warn('Could not reload ' .. player.Name .. ': ' .. tostring(err)) end
    end)
end

local function dressKiller(player)
    local character = player.Character
    if not character then return end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA('Accessory') or item:IsA('Shirt') or item:IsA('Pants')
            or item:IsA('ShirtGraphic') or item:IsA('BodyColors') then
            item:Destroy()
        elseif item:IsA('BasePart') and item.Name ~= 'HumanoidRootPart' then
            item.Color = Color3.fromRGB(28, 36, 44)
            item.Material = Enum.Material.SmoothPlastic
        end
    end
    local head = character:FindFirstChild('Head')
    if not head then return end
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA('Decal') then child:Destroy() end
    end
    local function facePart(name, size, offset, color)
        local part = Instance.new('Part')
        part.Name, part.Size, part.Color = name, size, color
        part.CanCollide, part.CanTouch, part.CanQuery, part.Massless = false, false, false, true
        part.CFrame = head.CFrame * CFrame.new(offset)
        part.Parent = character
        local weld = Instance.new('WeldConstraint')
        weld.Part0, weld.Part1, weld.Parent = head, part, part
    end
    local width, height, depth = head.Size.X, head.Size.Y, head.Size.Z
    facePart('WhiteMask', Vector3.new(width * 0.8, height * 0.94, 0.16),
        Vector3.new(0, 0, -depth / 2 - 0.06), Color3.fromRGB(223, 221, 207))
    for _, x in ipairs({-0.2, 0.2}) do
        facePart('MaskEye', Vector3.new(width * 0.16, height * 0.12, 0.06),
            Vector3.new(width * x, height * 0.1, -depth / 2 - 0.16), Color3.fromRGB(10, 10, 12))
    end
    facePart('MaskMouth', Vector3.new(width * 0.22, height * 0.04, 0.06),
        Vector3.new(0, -height * 0.24, -depth / 2 - 0.16), Color3.fromRGB(55, 53, 50))
end

local function catchTouch(killer, other)
    local activeRound = round
    if not activeRound or activeRound.result then return end
    local character = other:FindFirstAncestorOfClass('Model')
    local victim = character and Players:GetPlayerFromCharacter(character)
    -- Accessories alone don't count as touching someone's body.
    if not victim or other.Parent ~= victim.Character or victim == killer then return end
    local killerRoot, victimRoot = root(killer), root(victim)
    local killerHumanoid, victimHumanoid = humanoid(killer), humanoid(victim)
    if not killerRoot or not victimRoot or not killerHumanoid or not victimHumanoid then return end
    if killerHumanoid.Health &lt;= 0 or victimHumanoid.Health &lt;= 0 then return end
    local displacement = victimRoot.Position - killerRoot.Position
    if displacement.Magnitude &gt; 7 then return end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {map}
    if workspace:Raycast(killerRoot.Position, displacement, params) then return end
    if Rules.capture(activeRound, killer.UserId, victim.UserId, now()) then
        retire(victim)
    end
end

local function onCharacter(player, character)
    local h = character:WaitForChild('Humanoid', 10)
    local r = character:WaitForChild('HumanoidRootPart', 10)
    if not h or not r or player.Character ~= character then return end
    h.WalkSpeed = 16
    h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    -- An unexpected replacement character never re-enters an active round.
    if round and round.characters[player.UserId] ~= character and round.members[player.UserId] then
        Rules.remove(round, player.UserId, now())
        setRole(player, 'Spectator')
        updateAlive()
    end
    teleport(player, lobbySpawn)
    if player:GetAttribute('MansionRole') == 'Spectator' then r.Anchored = true end
    if not round and RunService:IsStudio() and #Players:GetPlayers() == 1 then
        local spawn = spawnFolder:FindFirstChild('01')
        if spawn then teleport(player, spawn) end
    end
    h.Died:Connect(function()
        if round and round.characters[player.UserId] == character then
            Rules.remove(round, player.UserId, now())
            setRole(player, 'Spectator')
            updateAlive()
        end
    end)
end

local function addPlayer(player)
    setRole(player, 'Waiting')
    player.CharacterAdded:Connect(function(character) onCharacter(player, character) end)
    if player.Character then task.spawn(onCharacter, player, player.Character) end
end
Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(function(player)
    loading[player] = nil
    if round then
        Rules.remove(round, player.UserId, now())
        updateAlive()
    end
end)
for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end

local function readyPlayers()
    local ready = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local h = humanoid(player)
        if not loading[player] and h and h.Health &gt; 0 and root(player)
            and player:HasAppearanceLoaded() then
            table.insert(ready, player)
        end
    end
    return ready
end
local function disconnectTouches()
    for _, connection in ipairs(touchConnections) do connection:Disconnect() end
    table.clear(touchConnections)
end

state:SetAttribute('Alive', 0)
state:SetAttribute('KillerName', '')
state:SetAttribute('Result', '')
while true do
    -- Also cover returning to a single Studio client after another client leaves.
    local waitingPlayers = Players:GetPlayers()
    if RunService:IsStudio() and #waitingPlayers == 1 and root(waitingPlayers[1]) then
        teleport(waitingPlayers[1], spawnFolder:WaitForChild('01'))
    end
    setPhase('Waiting', 0, RunService:IsStudio()
        and 'Explore the mansion. Start a test with 2+ players for a round.'
        or 'Waiting for at least 2 players...')
    repeat task.wait(1) until #readyPlayers() &gt;= 2
    local intermissionEnds = now() + Config.Intermission
    setPhase('Intermission', intermissionEnds, 'A new hunt begins soon.')
    repeat task.wait(0.25) until now() &gt;= intermissionEnds or #readyPlayers() &lt; 2
    local roster = readyPlayers()
    if #roster &lt; 2 then continue end
    -- Shuffle so overflow spectators get a fair chance next round.
    for i = #roster, 2, -1 do
        local j = random:NextInteger(1, i)
        roster[i], roster[j] = roster[j], roster[i]
    end
    while #roster &gt; Config.MaxPlayers do table.remove(roster) end
    local killer = roster[1]
    local ids = {}
    for _, player in ipairs(roster) do table.insert(ids, player.UserId) end
    local activeRound = Rules.new(ids, killer.UserId, now(), Config.RoundSeconds, Config.HeadStart)
    activeRound.characters = {}
    for _, player in ipairs(roster) do activeRound.characters[player.UserId] = player.Character end
    round = activeRound
    state:SetAttribute('Result', '')
    state:SetAttribute('KillerName', killer.DisplayName)
    local spawns = spawnFolder:GetChildren()
    table.sort(spawns, function(a, b) return a.Name &lt; b.Name end)
    for i, player in ipairs(roster) do
        local r, h = root(player), humanoid(player)
        r.Anchored = false
        h.WalkSpeed = 16
        h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        for _, child in ipairs(player.Character:GetChildren()) do
            if child:IsA('ForceField') then child:Destroy() end
        end
        setRole(player, i == 1 and 'Killer' or 'Survivor')
        teleport(player, i == 1 and killerSpawn or spawns[((i - 2) % #spawns) + 1])
    end
    dressKiller(killer)
    root(killer).Anchored = true
    for _, part in ipairs(killer.Character:GetChildren()) do
        if part:IsA('BasePart') and part.CanTouch then
            table.insert(touchConnections, part.Touched:Connect(function(other) catchTouch(killer, other) end))
        end
    end
    updateAlive()
    setPhase('HeadStart', activeRound.chaseAt, 'Survivors: find a hiding place!')
    local released = false
    while not Rules.tick(activeRound, now()) do
        if not released and now() &gt;= activeRound.chaseAt then
            released = true
            if root(killer) then
                teleport(killer, entranceSpawn)
                root(killer).Anchored = false
            end
            setPhase('Running', activeRound.endsAt, 'Survive until the timer reaches zero.')
        end
        task.wait(0.1)
    end
    disconnectTouches()
    state:SetAttribute('Result', activeRound.result)
    local message = activeRound.result == 'Survivors' and 'SURVIVOR TEAM WINS — someone survived five minutes!'
        or activeRound.result == 'Killer' and 'MICHAEL MYERS WINS — all survivors were caught!'
        or 'ROUND CANCELLED — the killer left or reset.'
    setPhase('Results', now() + 8, message)
    for _, player in ipairs(roster) do if root(player) then root(player).Anchored = true end end
    task.wait(8)
    round = nil
    for _, player in ipairs(Players:GetPlayers()) do
        setRole(player, 'Waiting')
        if root(player) then root(player).Anchored = false end
        safeReload(player)
    end
    updateAlive()
    state:SetAttribute('KillerName', '')
    state:SetAttribute('Result', '')
end
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX253"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">18</float><float name="CameraMinZoomDistance">0.5</float></Properties><Item class="StarterPlayerScripts" referent="RBX252"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX246"><Properties><string name="Name">MansionClient</string><ProtectedString name="Source">local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local player = Players.LocalPlayer
local state = ReplicatedStorage:WaitForChild('MansionState')
local gui = Instance.new('ScreenGui')
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = 'MansionHUD', false, false
gui.Parent = player:WaitForChild('PlayerGui')
local function label(parent, name, text, position, size, fontSize, color)
    local object = Instance.new('TextLabel')
    object.Name, object.Text, object.Position, object.Size = name, text, position, size
    object.BackgroundTransparency = 1
    object.TextColor3 = color or Color3.fromRGB(235, 229, 213)
    object.Font, object.TextSize, object.TextWrapped = Enum.Font.GothamMedium, fontSize, true
    object.Parent = parent
    return object
end
local panel = Instance.new('Frame')
panel.Name, panel.AnchorPoint, panel.Position = 'RoundPanel', Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8)
panel.Size = UDim2.new(0.9, 0, 0, 134)
panel.BackgroundColor3, panel.BackgroundTransparency = Color3.fromRGB(16, 20, 24), 0.1
panel.BorderSizePixel, panel.Parent = 0, gui
local limit = Instance.new('UISizeConstraint')
limit.MaxSize, limit.Parent = Vector2.new(650, 134), panel
local corner = Instance.new('UICorner')
corner.CornerRadius, corner.Parent = UDim.new(0, 10), panel
label(panel, 'Title', 'MIDNIGHT MANOR', UDim2.new(0, 12, 0, 8), UDim2.new(1, -24, 0, 20), 17)
local clockLabel = label(panel, 'Clock', '--:--', UDim2.new(0.35, 0, 0, 31), UDim2.new(0.3, 0, 0, 36), 30)
local roleLabel = label(panel, 'Role', '', UDim2.new(0, 10, 0, 35), UDim2.new(0.35, -10, 0, 30), 13)
local aliveLabel = label(panel, 'Alive', '', UDim2.new(0.65, 0, 0, 35), UDim2.new(0.35, -10, 0, 30), 13)
local messageLabel = label(panel, 'Message', '', UDim2.new(0, 12, 0, 75), UDim2.new(1, -24, 0, 48), 14)
local spectate = Instance.new('Frame')
spectate.Name, spectate.AnchorPoint = 'Spectate', Vector2.new(0.5, 1)
spectate.Position, spectate.Size = UDim2.new(0.5, 0, 1, -20), UDim2.new(0.86, 0, 0, 56)
spectate.BackgroundColor3, spectate.BorderSizePixel, spectate.Parent = Color3.fromRGB(16, 20, 24), 0, gui
local specLimit = Instance.new('UISizeConstraint')
specLimit.MaxSize, specLimit.Parent = Vector2.new(440, 56), spectate
local specCorner = corner:Clone()
specCorner.Parent = spectate
local targetLabel = label(spectate, 'Target', '', UDim2.new(0, 60, 0, 0), UDim2.new(1, -120, 1, 0), 14)
local selectedId = nil
local currentTargets = {}
local function button(text, x, anchor)
    local b = Instance.new('TextButton')
    b.Text, b.TextSize, b.Font = text, 24, Enum.Font.GothamBold
    b.Size, b.Position, b.AnchorPoint = UDim2.fromOffset(50, 44), UDim2.new(x, 0, 0.5, 0), Vector2.new(anchor, 0.5)
    b.BackgroundColor3, b.TextColor3 = Color3.fromRGB(63, 37, 39), Color3.new(1, 1, 1)
    b.BorderSizePixel, b.Parent = 0, spectate
    return b
end
local previousButton, nextButton = button('&lt;', 0, 0), button('&gt;', 1, 1)
local function cycle(direction)
    if #currentTargets == 0 then selectedId = nil return end
    local index = 1
    for i, target in ipairs(currentTargets) do if target.UserId == selectedId then index = i break end end
    selectedId = currentTargets[((index - 1 + direction) % #currentTargets) + 1].UserId
end
previousButton.Activated:Connect(function() cycle(-1) end)
nextButton.Activated:Connect(function() cycle(1) end)
local lastUpdate = 0
RunService.RenderStepped:Connect(function()
    local time = workspace:GetServerTimeNow()
    if time - lastUpdate &lt; 0.1 then return end
    lastUpdate = time
    local phase = state:GetAttribute('Phase') or 'Waiting'
    local role = player:GetAttribute('MansionRole') or 'Waiting'
    local running = phase == 'Running' or phase == 'HeadStart'
    local remaining = math.max(0, math.ceil((state:GetAttribute('EndsAt') or 0) - time))
    clockLabel.Text = phase == 'Waiting' and '--:--' or string.format('%d:%02d', math.floor(remaining / 60), remaining % 60)
    roleLabel.Text = role == 'Killer' and 'MICHAEL MYERS' or string.upper(role)
    roleLabel.TextColor3 = role == 'Killer' and Color3.fromRGB(235, 104, 100) or Color3.fromRGB(198, 215, 191)
    aliveLabel.Text = running and tostring(state:GetAttribute('Alive') or 0) .. ' SURVIVORS' or string.upper(phase)
    messageLabel.Text = state:GetAttribute('Message') or ''
    if phase == 'HeadStart' and role == 'Killer' then
        messageLabel.Text = 'You are Michael Myers. You will be released when this countdown ends.'
    elseif phase == 'Running' and role == 'Killer' then
        messageLabel.Text = 'Touch every survivor before time runs out.'
    elseif running and role == 'Spectator' then
        messageLabel.Text = 'You were eliminated. Your team can still win!'
    end
    spectate.Visible = running and (role == 'Spectator' or role == 'Waiting')
    currentTargets = {}
    for _, target in ipairs(Players:GetPlayers()) do
        local h = target.Character and target.Character:FindFirstChildOfClass('Humanoid')
        if target:GetAttribute('MansionRole') == 'Survivor' and h and h.Health &gt; 0 then
            table.insert(currentTargets, target)
        end
    end
    table.sort(currentTargets, function(a, b) return a.UserId &lt; b.UserId end)
    local selected = nil
    for _, target in ipairs(currentTargets) do if target.UserId == selectedId then selected = target end end
    if not selected then selected = currentTargets[1] end
    selectedId = selected and selected.UserId or nil
    local subject = nil
    if spectate.Visible and selected then
        subject = selected.Character:FindFirstChildOfClass('Humanoid')
        targetLabel.Text = 'WATCHING ' .. selected.DisplayName
    else
        subject = player.Character and player.Character:FindFirstChildOfClass('Humanoid')
        targetLabel.Text = 'Waiting for survivors...'
    end
    previousButton.Visible, nextButton.Visible = #currentTargets &gt; 1, #currentTargets &gt; 1
    local camera = workspace.CurrentCamera
    if subject and camera then
        camera.CameraType = Enum.CameraType.Custom
        if camera.CameraSubject ~= subject then camera.CameraSubject = subject end
    end
end)
